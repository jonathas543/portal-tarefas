              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Atualiza uma tarefa (exige o rowVersion lido)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
