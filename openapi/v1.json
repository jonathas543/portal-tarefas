    "/api/tarefas": {
      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Lista tarefas com paginação, filtros e ordenação",
        "parameters": [
          {
            "name": "Pagina",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32"
            }
          },
          {
            "name": "Tamanho",
            "in": "query",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32"
            }
          },
          {
            "name": "OrdenarPor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Direcao",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Situacao",
            "in": "query",
            "schema": {
              "pattern": "^(Pendente|EmAndamento|Concluida)$",
              "type": "string"
            }
          },
          {
            "name": "Prioridade",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Prioridade"
            }
          },
          {
            "name": "Busca",
            "in": "query",
            "schema": {
              "maxLength": 50,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "PrazoAte",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaDtoOfTarefaResumoDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Cria uma tarefa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaCriarDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaCriarDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TarefaCriarDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TarefaDetalhesDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
