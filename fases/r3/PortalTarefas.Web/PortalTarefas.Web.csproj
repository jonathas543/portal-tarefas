<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- User Secrets: connection string e senhas de seed ficam fora do repositório -->
    <UserSecretsId>portaltarefas-web-7f3c1d52-0a6b-4a5e-9a52</UserSecretsId>
  </PropertyGroup>

  <!-- Versões flutuantes restritas à linha do .NET 10; as versões efetivas ficam em "dotnet list package". -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Dapper" Version="2.*" />
  </ItemGroup>

</Project>
